FLASK_ENV=development
DATABASE_URL=sqlite:///app.db
SECRET_KEY=your-secret-key-here

# Optional: GitHub Personal Access Token for higher API rate limits
# Get one at: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here

# Agent Platform webhook secret for HMAC-SHA256 signature verification
AGENT_WEBHOOK_SECRET=your_agent_webhook_secret_here

# ATS API URL (used by sourcer_agent and screening_pipeline)
ATS_API_URL=http://localhost:5000